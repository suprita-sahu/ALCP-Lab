#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
struct Job{
char id;
int dead;
int profit;
};
bool compare(Job a,Job b){
return a.profit>b.profit;
}
void printJobScheduling(vector<Job> &arr,int n){
sort(arr.begin(),arr.end(),compare);
vector<int> result(n);
vector<bool> slot(n,false);
int maxProfit=0;
for(int i=0;i<n;i++){
for(int j=min(n,arr[i].dead)-1;j>=0;j--){
if(slot[j]==false){
result[j]=i;
slot[j]=true;
maxProfit+=arr[i].profit;
break;
}
}
}
cout<<"Job Sequence: ";
for(int i=0;i<n;i++){
if(slot[i]){
cout<<arr[result[i]].id<<" ";
}
}
cout<<"\nTotal Profit: "<<maxProfit<<"\n";
}
int main(){
vector<Job> arr;
Job j1={'a',2,100};
Job j2={'b',1,19};
Job j3={'c',2,27};
Job j4={'d',1,25};
Job j5={'e',3,15};
arr.push_back(j1);
arr.push_back(j2);
arr.push_back(j3);
arr.push_back(j4);
arr.push_back(j5);
int n=arr.size();
printJobScheduling(arr,n);
return 0;
}
