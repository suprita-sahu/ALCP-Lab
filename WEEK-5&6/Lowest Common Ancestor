#include <iostream>

struct Node {
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = NULL;
        right = NULL;
    }
};

// Function to find LCA in a Binary Tree
Node* findLCA_BT(Node* root, int n1, int n2) {
    if (root == NULL) {
        return NULL;
    }

    // If either n1 or n2 matches the root's key, root is the LCA candidate
    if (root->data == n1 || root->data == n2) {
        return root;
    }

    // Look for keys in left and right subtrees
    Node* leftLCA = findLCA_BT(root->left, n1, n2);
    Node* rightLCA = findLCA_BT(root->right, n1, n2);

    // If both returned non-NULL, one key is in one subtree and the other is in the other
    if (leftLCA != NULL && rightLCA != NULL) {
        return root;
    }

    // Otherwise return whichever subtree found a match
    return (leftLCA != NULL) ? leftLCA : rightLCA;
}
