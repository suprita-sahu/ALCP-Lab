// Node structure for adjacency list
struct AdjListNode {
    int dest;
    AdjListNode* next;

    AdjListNode(int d) {
        dest = d;
        next = NULL;
    }
};

class Graph {
    int V;                  // Number of vertices
    AdjListNode** adj;      // Array of adjacency lists

public:
