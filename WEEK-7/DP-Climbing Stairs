#include <iostream>

// Approach 1: Space-Optimized DP (Fibonacci style)
// Time Complexity: O(n), Auxiliary Space: O(1)
int climbStairsOptimized(int n) {
    if (n <= 2) {
        return n;
    }

    int prev2 = 1; // ways to reach step 1
    int prev1 = 2; // ways to reach step 2

    for (int i = 3; i <= n; i++) {
        int curr = prev1 + prev2;
        prev2 = prev1;
        prev1 = curr;
    }

    return prev1;
}

// Approach 2: Tabulation DP (Bottom-Up Array)
// Time Complexity: O(n), Auxiliary Space: O(n)
int climbStairsDP(int n) {
    if (n <= 2) {
        return n;
    }

    int* dp = new int[n + 1];
    dp[1] = 1;
    dp[2] = 2;

    for (int i = 3; i <= n; i++) {
        dp[i] = dp[i - 1] + dp[i - 2];
    }

    int result = dp[n];
    delete[] dp;
    return result;
}

int main() {
    int n = 5;

    std::cout << "Number of ways to climb " << n << " stairs (Optimized): " 
              << climbStairsOptimized(n) << std::endl;

    std::cout << "Number of ways to climb " << n << " stairs (Tabulation): " 
              << climbStairsDP(n) << std::endl;

    return 0;
}
