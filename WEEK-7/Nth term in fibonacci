#include <iostream>

// Approach 1: Space-Optimized DP
// Time Complexity: O(n), Auxiliary Space: O(1)
long long fibonacciOptimized(int n) {
    if (n <= 0) return 0;
    if (n == 1) return 1;

    long long prev2 = 0; // F(0)
    long long prev1 = 1; // F(1)

    for (int i = 2; i <= n; i++) {
        long long curr = prev1 + prev2;
        prev2 = prev1;
        prev1 = curr;
    }

    return prev1;
}

// Approach 2: Bottom-Up Tabulation DP
// Time Complexity: O(n), Auxiliary Space: O(n)
long long fibonacciDP(int n) {
    if (n <= 0) return 0;
    if (n == 1) return 1;

    long long* dp = new long long[n + 1];
    dp[0] = 0;
    dp[1] = 1;

    for (int i = 2; i <= n; i++) {
        dp[i] = dp[i - 1] + dp[i - 2];
    }

    long long result = dp[n];
    delete[] dp;
    return result;
}

int main() {
    int n = 10;

    std::cout << "Finding the " << n << "th Fibonacci term:\n";
    std::cout << "Using Space-Optimized DP: " << fibonacciOptimized(n) << std::endl;
    std::cout << "Using Tabulation DP     : " << fibonacciDP(n) << std::endl;

    return 0;
}
