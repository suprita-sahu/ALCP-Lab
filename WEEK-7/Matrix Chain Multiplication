#include <iostream>
#include <climits>

// Recursive helper to print the optimal parenthesization using split table 's'
void printOptimalParenthesis(int** s, int i, int j, char& name) {
    if (i == j) {
        std::cout << name++;
        return;
    }
    std::cout << "(";
    printOptimalParenthesis(s, i, s[i][j], name);
    printOptimalParenthesis(s, s[i][j] + 1, j, name);
    std::cout << ")";
}

// Function to calculate minimum multiplication operations
int matrixChainOrder(int p[], int n) {
    // n is the length of array p. Number of matrices is n - 1.
    // m[i][j] stores the minimum number of scalar multiplications
    // needed to compute the matrix product A[i]...A[j] (1-indexed)
    int** m = new int*[n];
    int** s = new int*[n];
    for (int i = 0; i < n; i++) {
        m[i] = new int[n];
        s[i] = new int[n];
    }

    // Cost is 0 when multiplying one matrix
    for (int i = 1; i < n; i++) {
        m[i][i] = 0;
    }

    // L is chain length (from 2 matrices up to n-1 matrices)
    for (int L = 2; L < n; L++) {
        for (int i = 1; i < n - L + 1; i++) {
            int j = i + L - 1;
            m[i][j] = INT_MAX;

            for (int k = i; k < j; k++) {
                // cost = cost of left subchain + cost of right subchain + multiplication cost
                int q = m[i][k] + m[k + 1][j] + p[i - 1] * p[k] * p[j];

                if (q < m[i][j]) {
                    m[i][j] = q;
                    s[i][j] = k; // Store optimal split point
                }
            }
        }
    }

    int minOperations = m[1][n - 1];

    std::cout << "Optimal Parenthesization: ";
    char name = 'A';
    printOptimalParenthesis(s, 1, n - 1, name);
    std::cout << std::endl;

    // Cleanup dynamic memory
    for (int i = 0; i < n; i++) {
        delete[] m[i];
        delete[] s[i];
    }
    delete[] m;
    delete[] s;

    return minOperations;
}

